<?xml version="1.0" encoding="UTF-8"?><schema xmlns="http://purl.oclc.org/dsdl/schematron"><ns prefix="tei" uri="http://www.tei-c.org/ns/1.0"/><pattern id="protocols"><rule context="tei:div[@type='protocol']"><assert test="@n">Every protocol division must have @n.</assert></rule><rule context="tei:rdg"><assert test="@wit">Every reading must point to a witness.</assert></rule><rule context="tei:persName|tei:placeName|tei:orgName|tei:title[@ref]"><assert test="@ref">Tagged entities must point to an authority file.</assert></rule></pattern></schema>